{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost\\sqlexpress;Initial Catalog=AIOrderInventoryDb;Integrated Security=True;Pooling=False;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "EnterpriseOMS.Api",
    "Audience": "EnterpriseOMS.Client",
    "AccessTokenExpiryMinutes": 15
  },
  "SeedAdmin": {
    "FullName": "System Administrator",
    "OrganizationId": 1
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/enterprise-oms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}